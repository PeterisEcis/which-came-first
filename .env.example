# Copy to .env for local runs. Real environment variables win over this file.

# Required. Wikimedia's User-Agent policy wants a way to reach whoever runs the
# generator: a repo URL or an email address.
WCF_CONTACT=

# Local development. Production leaves DJANGO_DEBUG unset and sets a real
# DJANGO_SECRET_KEY instead; without either, Django refuses to start.
DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to the database `docker compose up -d` starts.
# DATABASE_URL=postgres://wcf:wcf@127.0.0.1:5432/wcf

# Optional.
# WCF_OUTPUT_DIR=output/puzzles
# WCF_FEED=selected
